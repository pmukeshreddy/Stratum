{
  "provider": {
    "name": "chat",
    "model": "REPLACE_WITH_YOUR_MODEL_ID",
    "base_url": "https://api.openai.com/v1",
    "api_key_env": "OPENAI_API_KEY",
    "streaming": true,
    "max_output_tokens": 2048,
    "timeout_seconds": 120
  },
  "context": {
    "max_tokens": 48000,
    "compact_at": 0.8,
    "result_chars": 1800
  },
  "limits": {
    "max_turns": 100,
    "token_budget": 500000,
    "wall_seconds": 3600,
    "concurrency": 4,
    "max_subagents": 10,
    "max_depth": 3
  },
  "permissions": ["workspace.read", "workspace.write", "python", "agents", "state"],
  "task": {"wait_for_children": true}
}
