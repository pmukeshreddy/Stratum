{
  "run": {
    "provider": {
      "name": "codex_subscription",
      "streaming": true,
      "max_output_tokens": 32768,
      "timeout_seconds": 180,
      "model": "gpt-6-astra",
      "parameters": {
        "reasoning_effort": "xhigh"
      }
    },
    "task": {
      "adapter": "workspace",
      "verifier": "none"
    },
    "control_plane": "python",
    "permissions": [
      "workspace.read",
      "workspace.write",
      "python",
      "process",
      "agents",
      "state",
      "mcp"
    ],
    "execution": {
      "backend": "local",
      "environment_allowlist": [
        "PATH",
        "LANG",
        "LC_ALL",
        "TMPDIR",
        "VIRTUAL_ENV"
      ],
      "output_chars": 65536
    },
    "context": {
      "max_tokens": 96000,
      "summary_chars": 6000,
      "result_chars": 131072
    },
    "limits": {
      "max_turns": 100,
      "token_budget": 500000,
      "wall_seconds": 180,
      "concurrency": 2,
      "max_subagents": 4,
      "max_depth": 3,
      "tool_timeout_seconds": 600,
      "max_model_calls": 150,
      "max_tool_calls": 500,
      "max_python_executions": 200
    }
  },
  "benchmarks": {
    "arc-agi-3": {
      "source": null,
      "commit": null,
      "python": "python3",
      "options": {
        "operation_mode": "OFFLINE",
        "environments_dir": null
      }
    }
  }
}
